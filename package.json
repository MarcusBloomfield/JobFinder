  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "npm run build:frontend",
    "build:frontend": "webpack --mode production",
    "build:backend": "cd backend && npm run build",
    "build:all": "npm run build:frontend && npm run build:backend",
