    "setup-backend": "node setup-backend.js",
    "backend": "cd backend && npm run dev",
    "predev": "npm run build:all",
    "dev": "concurrently \"npm start\" \"npm run backend\"",
    "test:openai": "cd backend && npm run test:openai"
  },
